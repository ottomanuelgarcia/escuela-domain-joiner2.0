#!/usr/bin/env python3
import tkinter as tk
from tkinter import messagebox, ttk
import subprocess
import os
import sys

class DomainJoinerApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Ingressar no Domínio da Escola")
        self.root.geometry("450x650") # Increased height for credits
        self.root.resizable(True, True)

        # Style customization
        style = ttk.Style()
        try:
            style.theme_use('clam')
        except:
            pass

        # Header
        header_frame = tk.Frame(root, bg="#2c3e50", height=60)
        header_frame.pack(fill="x")
        header_label = tk.Label(header_frame, text="Configuração de Domínio", 
                               bg="#2c3e50", fg="white", font=("Helvetica", 14, "bold"))
        header_label.pack(pady=15)

        # Main Content Frame
        main_frame = tk.Frame(root, padx=20, pady=20)
        main_frame.pack(fill="both", expand=True)

        # Domain Input
        tk.Label(main_frame, text="Nome do Domínio (ex. escisah.edu):", anchor="w").pack(fill="x")
        self.domain_entry = ttk.Entry(main_frame)
        self.domain_entry.pack(fill="x", pady=(0, 10))

        # Admin User Input
        tk.Label(main_frame, text="Usuário Administrador:", anchor="w").pack(fill="x")
        self.user_entry = ttk.Entry(main_frame)
        self.user_entry.insert(0, "Administrator")
        self.user_entry.pack(fill="x", pady=(0, 10))

        # Password Input
        tk.Label(main_frame, text="Senha:", anchor="w").pack(fill="x")
        
        pass_frame = tk.Frame(main_frame)
        pass_frame.pack(fill="x", pady=(0, 5))
        
        self.password_entry = ttk.Entry(pass_frame, show="*")
        self.password_entry.pack(side="left", fill="x", expand=True)

        # Show Password Toggle
        self.show_pass_var = tk.IntVar()
        self.show_pass_check = ttk.Checkbutton(main_frame, text="Mostrar senha", variable=self.show_pass_var, command=self.toggle_password)
        self.show_pass_check.pack(anchor="w", pady=(0, 20))

        # Button Frame
        button_frame = tk.Frame(main_frame)
        button_frame.pack(fill="x", pady=10)

        # Cancel Button
        self.cancel_button = ttk.Button(button_frame, text="Cancelar", command=self.root.destroy)
        self.cancel_button.pack(side="right", padx=5)

        # Join Button (Accept)
        self.join_button = ttk.Button(button_frame, text="Ingressar (Aceitar)", command=self.join_domain)
        self.join_button.pack(side="right", padx=5)

        # Status Label
        self.status_label = tk.Label(main_frame, text="", fg="blue", wraplength=400)
        self.status_label.pack(pady=5)

        # Credits Frame
        credits_frame = tk.LabelFrame(main_frame, text="Sobre o Autor", padx=10, pady=10)
        credits_frame.pack(fill="x", pady=(20, 0), side="bottom")
        
        credits_text = (
            "Este programa foi criado pelo MSc. Otto Manuel Garcia Preval.\n"
            "Você pode contatá-lo:\n"
            "Telefone: 948199810\n"
            "E-mail: ottomanuelgarcia@gmail.com"
        )
        tk.Label(credits_frame, text=credits_text, justify="center", fg="#555").pack()

    def toggle_password(self):
        if self.show_pass_var.get():
            self.password_entry.config(show="")
        else:
            self.password_entry.config(show="*")

    def join_domain(self):
        domain = self.domain_entry.get().strip()
        user = self.user_entry.get().strip()
        password = self.password_entry.get().strip()

        if not domain or not user or not password:
            messagebox.showerror("Erro", "Por favor, preencha todos os campos.")
            return

        # Removed root check - we will use pkexec for the specific command

        self.join_button.config(state="disabled")
        self.status_label.config(text="Solicitando permissões... Verifique a senha de root.")
        self.root.update()

        try:
            # Using pkexec to run realm with root privileges
            # IMPORTANT: pkexec passes stdin to the executed command, so we can pipe the password
            cmd = ['pkexec', 'realm', 'join', '--verbose', f'--user={user}', domain]
            
            proc = subprocess.Popen(
                cmd,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            
            # We send the password for the DOMAIN user to realm
            # pkexec will handle the ROOT password interaction via GUI dialog
            stdout, stderr = proc.communicate(input=password)

            if proc.returncode == 0:
                msg = f"O computador ingressou com sucesso no domínio {domain}.\n\nDeseja reiniciar o computador agora para aplicar as alterações?"
                if messagebox.askyesno("Sucesso", msg):
                     # Reboot also needs root, or policykit permission
                    subprocess.run(['pkexec', 'reboot'])
                else:
                    self.root.destroy()
            else:
                error_msg = stderr if stderr else stdout
                # If user cancels pkexec auth, it usuallly returns 126 or 127 or similar
                if "Not authorized" in error_msg or "authentication" in error_msg.lower():
                     messagebox.showwarning("Cancelado", "Autenticação cancelada ou falhou.")
                else:
                     messagebox.showerror("Erro ao ingressar", f"Ocorreu um erro:\n{error_msg}")
                self.status_label.config(text="Falha ao ingressar no domínio.")
                self.join_button.config(state="normal")
                
        except FileNotFoundError:
             messagebox.showerror("Erro", "Comando 'realm' ou 'pkexec' não encontrado.")
             self.join_button.config(state="normal")
        except Exception as e:
            messagebox.showerror("Erro", f"Erro inesperado:\n{str(e)}")
            self.join_button.config(state="normal")


if __name__ == "__main__":
    root = tk.Tk()
    app = DomainJoinerApp(root)
    root.mainloop()
